# 部署与素材
POSE_DEPLOYMENT=personal          # personal | commercial
POSE_LIBRARY=upstream             # upstream | own（own 时索引不得包含上游姿势）
POSE_INDEX=index/pose_outfit_index.json
POSE_STATE_DIR=                   # 留空用 ~/.local/state/pose-outfit

# 渲染器
POSE_RENDERER=mock                # mock | host
POSE_RENDER_COMMAND=              # host: 接收 stdin JSON，输出 {"run_id": "..."}
POSE_RENDER_POLL_COMMAND=         # host: 接收 {"run_id"}，输出 {"status","images","error"}
POSE_RENDER_CAPABILITIES=         # 可选 JSON，覆盖 capabilities
POSE_RENDER_TIMEOUT=120

# 会话与素材限制
POSE_SESSION_TTL_HOURS=24
POSE_SESSION_MAX_BATCH=5
POSE_ASSET_TIMEOUT=20
POSE_ASSET_MAX_BYTES=12000000
POSE_SUBJECT_MAX_BYTES=10000000
